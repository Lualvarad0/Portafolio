# Public site URL (used for canonical, hreflang, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.alvarado-dev.com

# EmailJS — contact form (read on the server after rate limiting)
# Enable non-browser API requests in EmailJS Account > Security.
EMAILJS_PUBLIC_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PRIVATE_KEY=

# Calendly
NEXT_PUBLIC_CALENDLY_URL=

# CallMeBot — WhatsApp notifications (SERVER-ONLY, never NEXT_PUBLIC_)
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Google Search Console
GOOGLE_SITE_VERIFICATION=
